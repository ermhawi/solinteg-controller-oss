[Unit]
Description=Volvo Smart Charging read-only Chronos status (no EVCC writes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hakan
Group=hakan
EnvironmentFile=/etc/solinteg/volvo-smart-status.env
ExecStart=/home/hakan/.local/share/volvo-smartcharging-oauth/.venv/bin/python -B /home/hakan/.local/share/volvo-smartcharging-oauth/smart_schedule_refresh.py
ExecStartPost=!/usr/bin/python3 -B /usr/local/lib/solinteg-volvo-smart-status/tools/publish_ev_volvo_smart_charging.py --source /home/hakan/.local/share/volvo-smartcharging-oauth/smart-schedule-current-readonly.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/hakan/.local/share/volvo-smartcharging-oauth /opt/solinteg/ev-shadow-runtime/var
TimeoutStartSec=90s
MemoryMax=160M
