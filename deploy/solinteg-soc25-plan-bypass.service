[Unit]
Description=Temporary battery-save plan bypass (no Modbus, no EVCC writes)
After=local-fs.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/solinteg-soc25-plan-bypass/temporary_soc25_plan_bypass.py --tick
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/opt/solinteg /var/lib/solinteg-soc25-plan-bypass
TimeoutStartSec=45
