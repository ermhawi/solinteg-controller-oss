[Unit]
Description=Restrict direct Solinteg web port 3007 to trusted networks
Before=solinteg-web.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/solinteg/solinteg-web-internal-only.nft
ExecReload=/usr/sbin/nft -f /etc/solinteg/solinteg-web-internal-only.nft
RemainAfterExit=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
