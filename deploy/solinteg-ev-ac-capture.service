[Unit]
Description=DEFA/ABL EVCC Ict2 AC-energy estimate (READ ONLY, gap-aware)
After=solinteg-ev-observer.service
Wants=solinteg-ev-observer.service

[Service]
Type=oneshot
User=solinteg-evshadow
Group=solinteg
WorkingDirectory=/opt/solinteg/ev-shadow-runtime
EnvironmentFile=/opt/solinteg/ev-shadow-runtime/ev-shadow.env
Environment=EV_ENABLED=0
Environment=EVCC_CONTROL_ARMED=0
Environment=EVCC_MANUAL_TEST=0
Environment=EVCC_START_APPROVED=0
Environment=EV_AC_CAPTURE_ENABLED=1
ExecStart=/usr/bin/python3 /opt/solinteg/ev-shadow-runtime/scripts/services/ev_ac_capture.py --capture
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/solinteg/ev-shadow-runtime/var
MemoryMax=128M
TimeoutStartSec=12
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
