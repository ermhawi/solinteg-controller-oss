[Unit]
Description=Solinteg EVCC price-controlled charging (single writer, explicitly armed)
After=network-online.target solinteg-ev-observer.service
Wants=network-online.target
ConditionPathExists=/opt/solinteg/ev-shadow-runtime/var/evcc-readonly.json

[Service]
Type=oneshot
User=solinteg-evshadow
Group=solinteg
WorkingDirectory=/opt/solinteg/ev-shadow-runtime
# Independent EVCC arming; never inherit the inverter dispatcher's ARMED env.
Environment=EV_PRICE_CONTROL_ENABLED=0
Environment=EVCC_PRICE_CONTROL_ARMED=0
Environment=EV_ENABLED=0
Environment=EVCC_CONTROL_ARMED=0
Environment=EVCC_START_APPROVED=0
# Optional extra interlock: never transfer a price-pause owner across a replug.
Environment=EVCC_CABLE_TRACK_PATH=/opt/solinteg/ev-shadow-runtime/var/evcc-cable-state.json
EnvironmentFile=-/etc/solinteg/ev-price-controller.env
ExecStart=/usr/bin/python3 -B /opt/solinteg/ev-shadow-runtime/scripts/services/ev_price_controller.py --once
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/solinteg/ev-shadow-runtime/var
MemoryMax=128M
IPAddressDeny=any
# Example only. Production install MUST pin exact Waveshare IPv4.
IPAddressAllow=192.168.0.20/32
RestrictAddressFamilies=AF_UNIX AF_INET
