# Proposed future READ-ONLY broker service. NOT INSTALLED, DO NOT ENABLE
# until the separately approved cutover: stop original poller first, verify
# its TCP:502 connection is gone, install this service and its poller drop-in.
# This service does not replace dispatcher/watchdog or enable control writes.
[Unit]
Description=Solinteg Modbus read-only broker (staged cutover only)
After=network-online.target
Wants=network-online.target
# Root creates this marker ONLY after approved cutover and confirmed
# shutdown of the old direct TCP poller. Installing the unit alone is inert.
ConditionPathExists=/run/solinteg-broker-readonly-approved

[Service]
Type=simple
User=solinteg
WorkingDirectory=/opt/solinteg/app
EnvironmentFile=/opt/solinteg/solinteg.env
Environment=SOLINTEG_BROKER_READONLY_ENABLED=1
Environment=SOLINTEG_BROKER_SOCKET=/run/solinteg-broker/broker.sock
RuntimeDirectory=solinteg-broker
RuntimeDirectoryMode=0700
ExecStart=/opt/solinteg/app/.venv/bin/python /opt/solinteg/app/scripts/services/modbus_broker_readonly_service.py --read-only
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
