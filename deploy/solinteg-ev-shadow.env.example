# An isolated observational sidecar, NOT the armed Solinteg inverter environment.
# This is a template only; actual credentials and values are NOT committed.
# Read by systemd EnvironmentFile=.
# All addresses below are SYNTHETIC EXAMPLES, not the reference site's IPs.
# Set HA_API_URL and EVCC_READ_HOST from the private deployment inventory.
#
# HA token must be stored separately in a 0400 file readable only by the
# dedicated solinteg-evshadow account. HA API key is not inherently read-only;
# our bridge makes GET requests only.
HA_API_URL=http://10.0.0.20:8123
HA_READONLY_TOKEN_FILE=/opt/solinteg/ev-shadow-runtime/var/ha.token

EV_SETTINGS_PATH=/opt/solinteg/ev-shadow-runtime/var/settings.json
EV_STATUS_PATH=/opt/solinteg/ev-shadow-runtime/var/status.json
EV_SESSION_PATH=/opt/solinteg/ev-shadow-runtime/var/strict-session.json
EV_SHADOW_SESSION_PATH=/opt/solinteg/ev-shadow-runtime/var/shadow-session.json
EV_SHADOW_PLAN_PATH=/opt/solinteg/ev-shadow-runtime/var/shadow-plan.json

# Keep defaults disabled until a site-specific read-only rollout is reviewed.
# A shadow scenario's capacity and efficiency are assumptions, NOT
# verified physical calibration; strict control sessions always stay invalid.
EV_SHADOW_ASSUMPTIONS_ENABLED=0
EV_SHADOW_ASSUMED_USABLE_KWH=
EV_SHADOW_ASSUMED_AC_EFFICIENCY=
EV_SHADOW_PLANNER_ENABLED=0
EV_SHADOW_MAX_CURRENT_A=6
EV_HA_POLL_SECONDS=60
EV_SHADOW_POLL_SECONDS=60
EV_SHADOW_SETTINGS_WRITES_ENABLED=0

# Waveshare transparent RS485/Ethernet: FC03 reads only.
EVCC_READ_ONLY_ENABLED=0
EVCC_READ_HOST=192.168.0.20
EVCC_READ_PORT=4196
EVCC_READ_POLL_SECONDS=30
EVCC_READONLY_PATH=/opt/solinteg/ev-shadow-runtime/var/evcc-readonly.json
EVCC_READ_LOCK_PATH=/opt/solinteg/ev-shadow-runtime/var/evcc-reader.lock

# Local-only history writer, isolated from the production telemetry DB.
# 30-day retention; unknown/stale readings are NULL, not a presumed 0 W/A.
EV_HISTORY_ENABLED=0
EV_HISTORY_DB_PATH=/opt/solinteg/ev-shadow-runtime/var/ev-history.sqlite
EV_HISTORY_POLL_SECONDS=30
EV_HISTORY_RETENTION_DAYS=30

# Read-only Volvo journal evidence; keep disabled until the authenticated
# HA /api/volvo_trip_energy/cost_segments view is deployed and checked.
# A successful capture records anonymous gross journey energy, NOT priced
# battery DC depletion or actual cost per mile.
EV_COST_CAPTURE_ENABLED=0
EV_COST_EVIDENCE_DB_PATH=/opt/solinteg/ev-shadow-runtime/var/ev-cost-evidence.sqlite
EV_COST_DB_PATH=/opt/solinteg/ev-shadow-runtime/var/ev-cost.sqlite

# Purely historical spot-price evidence, excludes grid tariff and contract
# reconciliation; never silently promote to invoices or vehicle charge events.
EV_COST_PRICE_CAPTURE_ENABLED=0
EV_COST_PRICE_EVIDENCE_DB_PATH=/opt/solinteg/ev-shadow-runtime/var/ev-cost-price-evidence.sqlite

# The DEFA/ABL EVCC Ict2 AC-to-car energy estimate is read-only;
# dedicated systemd service overrides the gate to 1, NEVER regular services.
# Assumes 230 V and power factor 1.0; not an EM111 meter or billable kWh.
EV_AC_CAPTURE_ENABLED=0
EV_AC_EVIDENCE_DB_PATH=/opt/solinteg/ev-shadow-runtime/var/ev-ac-estimate.sqlite

# Both are read-only in this service; NEVER include the inverter write env.
TELEMETRY_DB_PATH=/opt/solinteg/telemetry.db
INVERTER_DATA_PATH=/opt/solinteg/live.json
SOLINTEG_FORECAST_RISK_PREMIUM_ORE=10
EV_ENABLED=0
EVCC_CONTROL_ARMED=0
EVCC_MANUAL_TEST=0
EVCC_START_APPROVED=0
